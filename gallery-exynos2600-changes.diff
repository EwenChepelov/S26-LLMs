 /** Utility object for hardware and device detection. */
 object HardwareUtils {
 
+  /**
+   * Returns true if the device runs a Samsung Exynos 2600 SoC (S5E9965 / E9965, Xclipse 960 GPU),
+   * e.g. the Galaxy S26 Exynos variant.
+   */
+  fun isExynos2600(
+    hardware: String = Build.HARDWARE,
+    board: String = Build.BOARD,
+    socModel: String = Build.SOC_MODEL,
+  ): Boolean {
+    val combined =
+      "${hardware.lowercase(Locale.ROOT)} ${board.lowercase(Locale.ROOT)} " +
+        "${socModel.lowercase(Locale.ROOT)}"
+    return "s5e9965" in combined ||
+      "e9965" in combined ||
+      "exynos2600" in combined ||
+      "exynos 2600" in combined
+  }
