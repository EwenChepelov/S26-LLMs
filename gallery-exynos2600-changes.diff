+  /**
+   * Creates and initializes the engine. On Exynos 2600 (Galaxy S26), the GPU backend can fail at
+   * init because Clspv (ANGLE-CL) rejects an ML Drift kernel (LiteRT-LM issue #2114); in that case
+   * fall back to CPU so the model stays usable.
+   */
+  @OptIn(ExperimentalApi::class) // opt-in experimental flags
+  private fun initializeEngineWithFallback(
+    model: Model,
+    engineConfig: EngineConfig,
+    speculativeDecoding: Boolean,
+  ): Engine {
+    try {
+      return createInitializedEngine(engineConfig, speculativeDecoding)
+    } catch (e: Exception) {
+      if (!HardwareUtils.isExynos2600() || model.currentAccelerator != Accelerator.GPU) {
+        throw e
+      }
+      Log.w(
+        TAG,
+        "GPU engine init failed on Exynos 2600 (LiteRT-LM issue #2114); falling back to CPU",
+        e,
+      )
+      return createInitializedEngine(engineConfig.copy(backend = Backend.CPU()), speculativeDecoding)
+    }
+  }
+
+  @OptIn(ExperimentalApi::class) // opt-in experimental flags
+  private fun createInitializedEngine(engineConfig: EngineConfig, speculativeDecoding: Boolean): Engine {
+    ExperimentalFlags.enableBenchmark = false
+    ExperimentalFlags.enableSpeculativeDecoding = speculativeDecoding
+    val engine = Engine(engineConfig)
+    try {
+      engine.initialize()
+    } catch (e: Exception) {
+      try {
+        engine.close()
+      } catch (_: Exception) {}
+      throw e
+    } finally {
+      ExperimentalFlags.enableSpeculativeDecoding = false
+      ExperimentalFlags.enableBenchmark = false
+    }
+    return engine
+  }
